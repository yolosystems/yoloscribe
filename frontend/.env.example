VITE_S3_BUCKET=agentscribe-dev
VITE_API_BASE=https://api.my-yoloscribe.example.com
VITE_SITE=default
# CloudFront domain for video/audio assets (leave empty in local dev)
VITE_CLOUDFRONT_MEDIA_DOMAIN=

# ── Auth provider ─────────────────────────────────────────────────────────────
# supabase (default) | oidc
#
# Browser login is always a PUBLIC client using authorization code + PKCE. No
# client secret belongs in any of these values — a browser cannot hold one.
VITE_AUTH_PROVIDER=supabase

# Supabase (VITE_AUTH_PROVIDER=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Generic OIDC (VITE_AUTH_PROVIDER=oidc) — works with any OIDC-compliant
# provider: Auth0, Keycloak, Okta, Cognito, Entra. Endpoints are read from the
# discovery document, so switching IdP is a config change and nothing more.
#
# Register the app as a public/SPA client with the redirect URI set to the site
# origin (e.g. https://app.yoloscribe.com) — OidcAuthClient uses window.location.origin.
VITE_OIDC_CONFIG_URL=
VITE_OIDC_CLIENT_ID=
# Optional. Default: "openid email profile offline_access".
# offline_access is what yields a refresh token; drop it and sessions will end at
# the access-token lifetime instead of renewing silently.
VITE_OIDC_SCOPE=
# Optional. Which token to send to the backend as the bearer: id (default) | access.
# Keep "id" when the backend's OIDC_AUDIENCE is unset or equals the client ID —
# that is the default and the ID token is what carries aud=client_id plus email.
# Use "access" only when the backend validates a separate API audience.
VITE_OIDC_TOKEN=

# Keep the Supabase pair above set even under VITE_AUTH_PROVIDER=oidc if inbound
# MCP clients (LiteLLM, Claude Code) authorize through Supabase's OAuth 2.1
# server: /oauth/consent is that flow's approval UI, and it is built whenever a
# Supabase project is configured — independent of how your own users sign in.
