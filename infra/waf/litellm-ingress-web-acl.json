{
  "Name": "yoloscribe-litellm-ingress",
  "Scope": "REGIONAL",
  "Description": "Shared ALB WebACL. Blocks /internal paths and path traversal on all hosts, ahead of the api-dev allow. Rest of api-dev allowed. litellm-dev default-DENY except the MCP OAuth handshake. Details in infra/waf/README.md",
  "DefaultAction": { "Block": {} },
  "VisibilityConfig": {
    "SampledRequestsEnabled": true,
    "CloudWatchMetricsEnabled": true,
    "MetricName": "yoloscribe-litellm-ingress"
  },
  "Rules": [
    {
      "Name": "block-internal-paths",
      "Priority": 0,
      "Action": { "Block": {} },
      "Statement": {
        "RegexMatchStatement": {
          "RegexString": "^/internal(/|$)",
          "FieldToMatch": { "UriPath": {} },
          "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" }, { "Priority": 1, "Type": "LOWERCASE" } ]
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "block-internal-paths"
      }
    },
    {
      "Name": "block-path-traversal",
      "Priority": 1,
      "Action": { "Block": {} },
      "Statement": {
        "RegexMatchStatement": {
          "RegexString": "\\.\\.",
          "FieldToMatch": { "UriPath": {} },
          "TextTransformations": [
            { "Priority": 0, "Type": "URL_DECODE" },
            { "Priority": 1, "Type": "COMPRESS_WHITE_SPACE" }
          ]
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "block-path-traversal"
      }
    },
    {
      "Name": "allow-api-dev-host",
      "Priority": 2,
      "Action": { "Allow": {} },
      "Statement": {
        "RegexMatchStatement": {
          "RegexString": "^api-dev\\.yoloscribe\\.com(:[0-9]+)?$",
          "FieldToMatch": { "SingleHeader": { "Name": "host" } },
          "TextTransformations": [ { "Priority": 0, "Type": "LOWERCASE" } ]
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "allow-api-dev-host"
      }
    },
    {
      "Name": "rate-limit-mcp",
      "Priority": 3,
      "Action": { "Block": {} },
      "Statement": {
        "RateBasedStatement": {
          "Limit": 300,
          "EvaluationWindowSec": 300,
          "AggregateKeyType": "IP",
          "ScopeDownStatement": {
            "RegexMatchStatement": {
              "RegexString": "^/mcp(/|$)",
              "FieldToMatch": { "UriPath": {} },
              "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
            }
          }
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "rate-limit-mcp"
      }
    },
    {
      "Name": "allow-mcp-oauth",
      "Priority": 4,
      "Action": { "Allow": {} },
      "Statement": {
        "OrStatement": {
          "Statements": [
            {
              "RegexMatchStatement": {
                "RegexString": "^/mcp(/|$)",
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": "^/\\.well-known/oauth-authorization-server",
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": "^/\\.well-known/oauth-protected-resource",
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": "^/callback(/|$)",
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
              }
            },
            {
              "RegexMatchStatement": {
                "RegexString": "^/[^/]+/(authorize|token|register)(/|$)",
                "FieldToMatch": { "UriPath": {} },
                "TextTransformations": [ { "Priority": 0, "Type": "URL_DECODE" } ]
              }
            }
          ]
        }
      },
      "VisibilityConfig": {
        "SampledRequestsEnabled": true,
        "CloudWatchMetricsEnabled": true,
        "MetricName": "allow-mcp-oauth"
      }
    }
  ]
}
