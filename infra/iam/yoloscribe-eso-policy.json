{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:<region>:<aws-account-id>:secret:yoloscribe/deploy/*"
    }
  ]
}
