{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:yoloscribe/__STAGE__/deploy/*"
    }
  ]
}
