{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SQSPoll",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:__AWS_REGION__:__AWS_ACCOUNT_ID__:yoloscribe-__STAGE__-*"
    },
    {
      "Sid": "S3ReadAgentDefs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::__S3_BUCKET__",
        "arn:aws:s3:::__S3_BUCKET__/*"
      ]
    },
    {
      "Sid": "S3WriteAgentRunnerOutputs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::__S3_BUCKET__/*/.agents/*/runs/*",
        "arn:aws:s3:::__S3_BUCKET__/*/.user/librarian/*",
        "arn:aws:s3:::__S3_BUCKET__/*/.user/notifications.md"
      ]
    },
    {
      "Sid": "SMReadUserWebhooks",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:yoloscribe/*/webhooks*"
    },
    {
      "Sid": "DynamoDBAgentLocks",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:__AWS_REGION__:__AWS_ACCOUNT_ID__:table/yoloscribe-__STAGE__-agent-locks"
    },
    {
      "Sid": "BedrockEmbed",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
    }
  ]
}
